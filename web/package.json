{
  "name": "kongzilla-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:standalone": "vite build --mode standalone",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"test/**/*.ts\" vite.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"test/**/*.ts\" vite.config.ts index.html",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
